{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetaverseMission",
  "type": "object",
  "required": ["missionId", "title", "missionType", "npcHost", "lifeEvidenceTier", "rewards"],
  "properties": {
    "missionId": { "type": "string" },
    "title": { "type": "string" },
    "missionType": {
      "type": "string",
      "enum": ["ONBOARDING", "EXPLORATION", "ENTITY_DRIVEN", "COOPERATIVE_CHALLENGE", "BUILD_CHALLENGE", "LIFE_ENVIRONMENTAL", "EVENT_LIMITED"]
    },
    "npcHost": { "type": "string" },
    "lifeEvidenceTier": {
      "type": "string",
      "enum": ["SIMULATED", "USER_REPORTED", "SENSOR_BACKED", "PARTNER_VALIDATED"]
    },
    "rewards": {
      "type": "object",
      "required": ["myz"],
      "properties": {
        "myz": { "type": "number", "minimum": 0 },
        "xp": { "type": "number", "minimum": 0 }
      }
    }
  }
}
