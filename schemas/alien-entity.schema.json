{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlienEntityDefinition",
  "description": "Schema definition for simulated alien entities in MyZubster Space Station.",
  "type": "object",
  "required": [
    "entity_id",
    "version",
    "name",
    "simulated_entity",
    "species",
    "civilization",
    "fictitious_origin",
    "role",
    "style",
    "focus_areas",
    "memory_namespace",
    "capabilities",
    "disclaimer"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^alien\\.[a-z0-9_-]+\\.v[0-9]+$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "simulated_entity": {
      "type": "boolean",
      "const": true
    },
    "species": {
      "type": "string"
    },
    "civilization": {
      "type": "string"
    },
    "fictitious_origin": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "focus_areas": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "memory_namespace": {
      "type": "string",
      "pattern": "^mem:alien\\.[a-z0-9_-]+\\.v[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": false
}
