{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetaverseInteractionEvent",
  "type": "object",
  "required": ["eventId", "sourceId", "targetId", "eventType", "timestamp"],
  "properties": {
    "eventId": { "type": "string" },
    "sourceId": { "type": "string" },
    "targetId": { "type": "string" },
    "eventType": {
      "type": "string",
      "enum": ["WAVE", "INSPECT", "TRADE_REQUEST", "QUEST_JOIN"]
    },
    "metadata": { "type": "object" },
    "timestamp": { "type": "string" }
  }
}
