{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LIFEMrvIndicator",
  "description": "Canonical schema for calculated MRV indicators with calculation trace and evidence linkage.",
  "type": "object",
  "required": [
    "indicator_id",
    "pilot_id",
    "domain",
    "kpi_name",
    "formula_version",
    "value",
    "unit",
    "period",
    "data_completeness_pct",
    "data_quality_score",
    "calculation_trace",
    "signature"
  ],
  "properties": {
    "indicator_id": {
      "type": "string",
      "pattern": "^IND_[A-Za-z0-9_:-]+$"
    },
    "pilot_id": {
      "type": "string",
      "pattern": "^PILOT_[A-Za-z0-9_:-]+$"
    },
    "domain": {
      "type": "string",
      "enum": ["WATER", "ENERGY", "WASTE", "BIODIVERSITY"]
    },
    "kpi_name": {
      "type": "string"
    },
    "formula_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+-[a-z0-9_.-]+$"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "data_completeness_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "data_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "calculation_trace": {
      "type": "object"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
