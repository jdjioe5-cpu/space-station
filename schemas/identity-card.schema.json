{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdentityCard",
  "type": "object",
  "required": ["identityId", "displayName", "handle", "archetypeSpecies", "entityType", "verificationBadge", "deepLink"],
  "properties": {
    "identityId": { "type": "string" },
    "displayName": { "type": "string" },
    "handle": { "type": "string" },
    "abbreviatedId": { "type": "string" },
    "archetypeSpecies": { "type": "string" },
    "entityType": {
      "type": "string",
      "enum": ["HUMAN", "SIMULATED"]
    },
    "verificationBadge": {
      "type": "string",
      "enum": ["VERIFIED", "UNVERIFIED"]
    },
    "deepLink": { "type": "string" },
    "avatarUrl": { "type": "string" },
    "createdAt": { "type": "string" }
  }
}
