{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetaverseTransaction",
  "type": "object",
  "required": ["txId", "senderId", "recipientId", "amountMYZ", "assetType", "status"],
  "properties": {
    "txId": { "type": "string" },
    "senderId": { "type": "string" },
    "recipientId": { "type": "string" },
    "amountMYZ": { "type": "number", "minimum": 0 },
    "assetType": {
      "type": "string",
      "enum": ["COSMETIC_SKIN", "SPACE_MODULE_UPGRADE", "STATION_TILE", "DIRECT_TRANSFER"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "CONFIRMED", "REJECTED_INSUFFICIENT_FUNDS", "REJECTED_SPEND_CAP"]
    }
  }
}
